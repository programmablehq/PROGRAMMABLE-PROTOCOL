{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:programmable:schema:market-template:v1",
  "title": "Programmable informative market template V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "protocol_spec_id",
    "namespace",
    "name",
    "revision",
    "summary",
    "domain_policy",
    "asset_roles",
    "actions",
    "extensions"
  ],
  "properties": {
    "$schema": {
      "const": "urn:programmable:schema:market-template:v1"
    },
    "protocol_spec_id": {
      "type": "string",
      "pattern": "^programmable-protocol/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.]+)?$"
    },
    "namespace": {
      "$ref": "#/$defs/semantic_id"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "revision": {
      "$ref": "#/$defs/decimal"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "domain_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector_id", "description"],
      "properties": {
        "selector_id": {
          "$ref": "#/$defs/semantic_id"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "asset_roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role_id", "description", "cardinality"],
        "properties": {
          "role_id": {
            "$ref": "#/$defs/semantic_id"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "cardinality": {
            "enum": ["one", "zero_or_one", "one_or_more", "zero_or_more"]
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "description",
          "required_protected_capabilities",
          "proposed_protected_effects",
          "opaque_engine_effects"
        ],
        "properties": {
          "action_id": {
            "$ref": "#/$defs/semantic_id"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "required_protected_capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/protected_capability_id"
            }
          },
          "proposed_protected_effects": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/engine_proposable_protected_effect_id"
            }
          },
          "opaque_engine_effects": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/opaque_engine_effect_id"
            }
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_.:-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/portable_value"
      }
    }
  },
  "$defs": {
    "decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "semantic_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._:-][a-z0-9][a-z0-9_-]*)+$",
      "maxLength": 160
    },
    "protected_capability_id": {
      "enum": [
        "programmable.capability.asset_move.v1",
        "programmable.capability.core_rights.v1",
        "programmable.capability.profile_operation.v1",
        "programmable.capability.temporary_obligation.v1",
        "programmable.capability.authorization_state.v1",
        "programmable.capability.domain_revision.v1"
      ]
    },
    "engine_proposable_protected_effect_id": {
      "enum": [
        "programmable.effect.asset_move.v1",
        "programmable.effect.core_rights_delta.v1",
        "programmable.effect.profile_operation.v1",
        "programmable.effect.temporary_obligation_open.v1"
      ]
    },
    "opaque_engine_effect_id": {
      "type": "string",
      "pattern": "^(?!programmable\\.)[a-z][a-z0-9]*(?:[._:-][a-z0-9][a-z0-9_-]*)+$",
      "maxLength": 160
    },
    "portable_value": {
      "oneOf": [
        {"type": "string"},
        {"type": "boolean"},
        {"type": "null"},
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/portable_value"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/portable_value"
          }
        }
      ]
    }
  }
}
