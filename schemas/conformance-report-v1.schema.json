{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:programmable:schema:conformance-report:v1",
  "title": "Programmable conformance report V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "protocol_spec_id",
    "protocol_commit",
    "constitution_id",
    "portable_vector_set_digest",
    "binding_id",
    "implementation_commit",
    "toolchain",
    "test_environment",
    "portable_profiles",
    "binding_native_profile_claims",
    "asset_profile_claims",
    "results"
  ],
  "properties": {
    "$schema": {"const": "urn:programmable:schema:conformance-report:v1"},
    "protocol_spec_id": {
      "type": "string",
      "pattern": "^programmable-protocol/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.]+)?$"
    },
    "protocol_commit": {"$ref": "#/$defs/git_commit"},
    "constitution_id": {"$ref": "#/$defs/digest"},
    "portable_vector_set_digest": {"$ref": "#/$defs/digest"},
    "binding_id": {
      "type": "string",
      "pattern": "^programmable-(?:evm|svm)/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.]+)?$"
    },
    "implementation_commit": {"$ref": "#/$defs/git_commit"},
    "toolchain": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "test_environment": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "portable_profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/profile_id"},
      "contains": {"const": "portable-core-v1"}
    },
    "binding_native_profile_claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/binding_native_profile_claim"}
    },
    "asset_profile_claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/asset_profile_claim"}
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "status"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
          "status": {"enum": ["pass", "fail", "not_applicable"]},
          "details": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {
              "properties": {"status": {"const": "pass"}},
              "required": ["status"]
            },
            "else": {
              "properties": {"details": {}},
              "required": ["details"]
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "repository_path": {
      "type": "string",
      "pattern": "^(?!(?:\\.{1,2})(?:/|$))[A-Za-z0-9._-]+(?:/(?!(?:\\.{1,2})(?:/|$))[A-Za-z0-9._-]+)*$"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._:-][a-z0-9][a-z0-9_-]*)+$"
    },
    "native_conformance_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_vector_set_path",
        "native_vector_set_digest",
        "native_test_report_path",
        "native_test_report_digest"
      ],
      "properties": {
        "native_vector_set_path": {"$ref": "#/$defs/repository_path"},
        "native_vector_set_digest": {"$ref": "#/$defs/digest"},
        "native_test_report_path": {"$ref": "#/$defs/repository_path"},
        "native_test_report_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "binding_native_profile_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_type", "profile_id", "conformance"],
      "properties": {
        "claim_type": {"const": "binding_native"},
        "profile_id": {"$ref": "#/$defs/profile_id"},
        "conformance": {"$ref": "#/$defs/native_conformance_evidence"}
      }
    },
    "asset_profile_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_type", "asset_profile_id", "conformance"],
      "properties": {
        "claim_type": {"const": "asset_profile"},
        "asset_profile_id": {"$ref": "#/$defs/profile_id"},
        "conformance": {"$ref": "#/$defs/native_conformance_evidence"}
      }
    }
  }
}
