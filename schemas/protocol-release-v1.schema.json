{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:programmable:schema:protocol-release:v1",
  "title": "Programmable protocol release inventory V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "protocol_spec_id",
    "constitution_document",
    "status",
    "production_eligible",
    "normative_documents",
    "schemas",
    "conformance_vectors"
  ],
  "properties": {
    "$schema": {
      "const": "urn:programmable:schema:protocol-release:v1"
    },
    "protocol_spec_id": {
      "type": "string",
      "pattern": "^programmable-protocol/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.]+)?$"
    },
    "constitution_document": {
      "type": "string",
      "pattern": "^constitution/(?!(?:\\.{1,2})(?:/|$))[A-Za-z0-9._-]+(?:/(?!(?:\\.{1,2})(?:/|$))[A-Za-z0-9._-]+)*\\.json$"
    },
    "status": {
      "enum": ["draft", "candidate", "final", "deprecated", "withdrawn"]
    },
    "production_eligible": {
      "description": "Explicit release-level gate for Production deployment claims. Production manifests require this value to be true on the exact protocol_commit selected by their Binding Release.",
      "type": "boolean"
    },
    "normative_documents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:spec|bindings)/(?!(?:\\.{1,2})(?:/|$))[A-Za-z0-9._-]+(?:/(?!(?:\\.{1,2})(?:/|$))[A-Za-z0-9._-]+)*\\.md$"
      }
    },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^schemas/(?!(?:\\.{1,2})(?:/|$))[A-Za-z0-9._-]+(?:/(?!(?:\\.{1,2})(?:/|$))[A-Za-z0-9._-]+)*\\.schema\\.json$"
      }
    },
    "conformance_vectors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^vectors/(?!(?:\\.{1,2})(?:/|$))[A-Za-z0-9._-]+(?:/(?!(?:\\.{1,2})(?:/|$))[A-Za-z0-9._-]+)*\\.json$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"production_eligible": {"const": true}},
        "required": ["production_eligible"]
      },
      "then": {
        "properties": {
          "status": {"const": "final"}
        }
      }
    }
  ],
  "$defs": {
    "repository_path": {
      "type": "string",
      "pattern": "^(?!(?:\\.{1,2})(?:/|$))[A-Za-z0-9._-]+(?:/(?!(?:\\.{1,2})(?:/|$))[A-Za-z0-9._-]+)*$"
    }
  }
}
