{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:programmable:schema:binding-release:v1",
  "title": "Programmable binding release manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "binding_id",
    "runtime_family",
    "protocol_spec_id",
    "protocol_commit",
    "constitution_id",
    "source",
    "toolchain",
    "reproducible_build_command",
    "native_interface",
    "artifact_digests",
    "portable_profiles",
    "portable_vector_set_digest",
    "binding_native_profile_claims",
    "asset_profile_claims",
    "conformance_report_digest",
    "known_limits"
  ],
  "properties": {
    "$schema": {
      "const": "urn:programmable:schema:binding-release:v1"
    },
    "binding_id": {
      "type": "string",
      "pattern": "^programmable-(evm|svm)/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.]+)?$"
    },
    "runtime_family": {
      "enum": ["EVM", "SVM"]
    },
    "protocol_spec_id": {
      "type": "string",
      "pattern": "^programmable-protocol/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.]+)?$"
    },
    "protocol_commit": {
      "$ref": "#/$defs/git_commit"
    },
    "constitution_id": {
      "$ref": "#/$defs/digest"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"$ref": "#/$defs/git_commit"}
      }
    },
    "toolchain": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "reproducible_build_command": {
      "type": "string",
      "minLength": 1
    },
    "native_interface": {"$ref": "#/$defs/native_artifact_record"},
    "artifact_digests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/native_artifact_record"}
    },
    "portable_profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/profile_id"},
      "contains": {"const": "portable-core-v1"}
    },
    "portable_vector_set_digest": {"$ref": "#/$defs/digest"},
    "binding_native_profile_claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/binding_native_profile_claim"}
    },
    "asset_profile_claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/asset_profile_claim"}
    },
    "conformance_report_digest": {"$ref": "#/$defs/digest"},
    "known_limits": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"runtime_family": {"const": "EVM"}},
        "required": ["runtime_family"]
      },
      "then": {
        "type": "object",
        "properties": {
          "binding_id": {
            "type": "string",
            "pattern": "^programmable-evm/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.]+)?$"
          },
          "native_interface": {
            "type": "object",
            "properties": {"kind": {"const": "abi"}}
          },
          "artifact_digests": {
            "type": "array",
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "properties": {"kind": {"const": "creation_bytecode"}},
                  "required": ["kind"]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {"kind": {"const": "runtime_bytecode"}},
                  "required": ["kind"]
                },
                "minContains": 1,
                "maxContains": 1
              }
            ]
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "binding_id": {
            "type": "string",
            "pattern": "^programmable-svm/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.]+)?$"
          },
          "native_interface": {
            "type": "object",
            "properties": {"kind": {"const": "idl"}}
          },
          "artifact_digests": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": {"kind": {"const": "elf"}},
              "required": ["kind"]
            },
            "minContains": 1,
            "maxContains": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "repository_path": {
      "type": "string",
      "pattern": "^(?!(?:\\.{1,2})(?:/|$))[A-Za-z0-9._-]+(?:/(?!(?:\\.{1,2})(?:/|$))[A-Za-z0-9._-]+)*$"
    },
    "native_artifact_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "authoritative_byte_source",
        "algorithm",
        "digest",
        "source_path"
      ],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
        "kind": {
          "enum": [
            "abi",
            "idl",
            "creation_bytecode",
            "runtime_bytecode",
            "elf",
            "generated_client_interface",
            "other"
          ]
        },
        "authoritative_byte_source": {"type": "string", "minLength": 1},
        "algorithm": {"const": "SHA-256"},
        "digest": {"$ref": "#/$defs/digest"},
        "source_path": {
          "type": "string",
          "pattern": "^(?!(?:\\.{1,2})(?:/|$))[A-Za-z0-9._-]+(?:/(?!(?:\\.{1,2})(?:/|$))[A-Za-z0-9._-]+)*$"
        }
      }
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._:-][a-z0-9][a-z0-9_-]*)+$"
    },
    "native_conformance_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_vector_set_path",
        "native_vector_set_digest",
        "native_test_report_path",
        "native_test_report_digest"
      ],
      "properties": {
        "native_vector_set_path": {"$ref": "#/$defs/repository_path"},
        "native_vector_set_digest": {"$ref": "#/$defs/digest"},
        "native_test_report_path": {"$ref": "#/$defs/repository_path"},
        "native_test_report_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "binding_native_profile_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_type", "profile_id", "conformance"],
      "properties": {
        "claim_type": {"const": "binding_native"},
        "profile_id": {"$ref": "#/$defs/profile_id"},
        "conformance": {"$ref": "#/$defs/native_conformance_evidence"}
      }
    },
    "asset_profile_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_type", "asset_profile_id", "conformance"],
      "properties": {
        "claim_type": {"const": "asset_profile"},
        "asset_profile_id": {"$ref": "#/$defs/profile_id"},
        "conformance": {"$ref": "#/$defs/native_conformance_evidence"}
      }
    }
  }
}
